# =============================================================================
# Cấu hình chạy trên máy (môi trường) — MỘT tệp dùng chung cho backend và giao diện.
#
#   Cách dùng: chép tệp này thành ".env" ở cùng thư mục (gốc repo) rồi điền giá trị.
#   ".env" đã nằm trong .gitignore: KHÔNG đưa lên git (có mật khẩu DB, khoá SpreadJS).
#
#   Ai đọc tệp .env:
#     - Backend: `gradlew bootRun` (trong backend/) nạp tệp này làm biến môi trường.
#       Test (`gradlew test`) KHÔNG đọc tệp này — test luôn chạy trên CSDL thử khai riêng.
#     - Giao diện: Vite (`npm run dev`, `npm run build` trong frontend/) đọc tệp này.
#       Chỉ biến bắt đầu bằng VITE_ được đưa vào mã chạy trên trình duyệt; các biến
#       khác (mật khẩu DB…) không bao giờ lộ ra trình duyệt.
#
#   Thứ tự ưu tiên: biến môi trường thật của máy / CI  >  tệp .env  >  mặc định trong mã.
#   Giá trị để trống = không khai (dùng mặc định).
#   Được dùng lại biến đã khai ở trên bằng ${TÊN}, ví dụ http://localhost:${BACKEND_PORT}/api.
# =============================================================================

# ----- Cổng (dùng chung) -----------------------------------------------------
# Cổng backend. Giao diện tự gọi API ở cổng này (VITE_API_URL bên dưới).
BACKEND_PORT=8114
# Cổng giao diện. Backend tự cho phép giao diện ở cổng này gọi API (CORS).
FRONTEND_PORT=8765
# local = chỉ mở được trên máy này; all = máy khác trong mạng mở được (mở tường lửa 2 cổng trên).
FRONTEND_HOST=local

# ----- Backend ---------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/asxh
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
# Khoá ký phiên đăng nhập (ít nhất 32 ký tự). Để trống chỉ được khi chạy thử trên máy mình;
# máy chủ thật PHẢI đặt chuỗi ngẫu nhiên riêng.
APP_SECURITY_JWT_SECRET=
# Thư mục lưu tệp đính kèm (xác nhận Kho bạc, hồ sơ báo cáo năm). Để trống = backend/data/attachments.
ASXH_ATTACHMENTS_DIR=
# Chỉ khai khi giao diện được mở từ địa chỉ khác localhost (ví dụ máy khác trong mạng):
# danh sách đầy đủ, cách nhau dấu phẩy. Để trống = http://localhost:${FRONTEND_PORT} và 127.0.0.1.
APP_CORS_ALLOWED_ORIGINS=

# ----- Giao diện -------------------------------------------------------------
# Địa chỉ API giao diện gọi. Mở từ máy khác thì thay localhost bằng IP / tên máy chủ.
VITE_API_URL=http://localhost:${BACKEND_PORT}/api
# Giấy phép SpreadJS (bảng tính nhập/xem/tổng hợp) và SpreadJS Designer (màn thiết kế mẫu).
# Để trống = bản dùng thử (bảng tính có chữ mờ). Khoá có dấu # thì PHẢI để trong ngoặc kép "...".
VITE_SPREADJS_LICENSE_KEY=
VITE_SPREADJS_DESIGNER_LICENSE_KEY=
