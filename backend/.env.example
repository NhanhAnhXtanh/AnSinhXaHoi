# Chép thành backend/.env (không đưa lên git). gradlew bootRun tự đọc; biến môi trường thật được ưu tiên.
SERVER_PORT=8114
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/asxh
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
APP_CORS_ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
APP_SECURITY_JWT_SECRET=
ASXH_ATTACHMENTS_DIR=
