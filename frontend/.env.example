# Base URL of the REST API. Defaults to the local Spring Boot backend when unset
# (see src/providers/constants.ts).
VITE_API_URL=http://localhost:8080/api

# Giấy phép SpreadJS (bảng tính nhập/xem/tổng hợp). Để trống = bản dùng thử:
# bảng tính có chữ mờ và một sheet "Evaluation Version" (tự bỏ khi lưu/xuất).
VITE_SPREADJS_LICENSE_KEY=
# Giấy phép SpreadJS Designer (màn thiết kế mẫu có ribbon). Để trống = bản dùng thử.
VITE_SPREADJS_DESIGNER_LICENSE_KEY=
